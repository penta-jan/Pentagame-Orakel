%%%%%%%%%% FIELDS, NAMES AND SYMMETRY
%
% Every field of the board is identified by its end points, coded as
% numbers: corner k = k, junction k = 5+k (k = 0..4, white = 0, green = 1,
% yellow = 2, red = 3, blue = 4).
%   corner or junction  e        -> {e}{-1}{0}
%   centre spot k       c k      -> {-2}{k}{0}
%   a stop              a<b, d   -> {a}{b}{d}, d counted from a
% The board's lines are: corner k -- corner k+1 (arcs), corner k --
% junction k+2 and k+3 (long lines), junction k -- junction k+1.
%
% A symmetry maps every index i to m*i+t (mod 5), m = 1 or -1.
% Names are attached to the drawn points through this map, so turning
% or mirroring a diagram only changes which point a name refers to.
%
% The drawn ("physical") points are named pp-e, pp-a-b-d and pp-c-k.

\ExplSyntaxOn

\seq_new:N \g__pp_records_seq
\seq_new:N \l__pp_items_seq
\seq_new:N \l__pp_stops_seq
\tl_new:N \l__pp_best_tl
\tl_new:N \l__pp_cur_tl
\tl_new:N \l__pp_name_tl
\tl_new:N \l__pp_col_tl
\tl_new:N \l__pp_craw_tl
\tl_new:N \l__pp_tri_tl
\tl_new:N \l__pp_squ_tl
\tl_new:N \l__pp_fill_tl
\tl_new:N \g__pp_code_tl
\tl_new:N \g__pp_string_tl
\int_new:N \l__pp_cidx_int
\int_new:N \l__pp_fa_int
\int_new:N \l__pp_fb_int
\int_new:N \l__pp_fd_int
\bool_new:N \l__pp_rawok_bool
\bool_new:N \l__pp_first_bool
\prop_new:c { g__pp_names_100_prop }
\prop_new:c { g__pp_names_50_prop }
\bool_new:c { g__pp_built_100_bool }
\bool_new:c { g__pp_built_50_bool }

\cs_generate_variant:Nn \prop_gput:Nnn { cee }
\prg_generate_conditional_variant:Nnn \prop_get:NnN { ceN } { T, F, TF }
\cs_generate_variant:Nn \clist_put_right:Nn { Ne }
\cs_generate_variant:Nn \tl_put_right:Nn { Ne }
\cs_generate_variant:Nn \str_range:nnn { e }
\cs_generate_variant:Nn \str_mdfive_hash:n { V }

% ---------- arithmetic

\cs_new:Npn \__pp_mod:n #1 { \int_mod:nn { (#1) + 500 } { 5 } }

% image of end point code #3 under i -> #1*i + #2, with corners and
% junctions exchanged if \l__pp_s_int = 1 (corner k <-> junction k)
\int_new:N \l__pp_s_int
\cs_new:Npn \__pp_phi:nnn #1#2#3
  {
    \int_eval:n
      { \int_mod:nn { \int_div_truncate:nn {#3} {5} + \l__pp_s_int } {2} * 5
        + \__pp_mod:n { (#1) * \int_mod:nn {#3} {5} + (#2) } }
  }

% number of stops between two end points (on the current board)
\cs_new:Npn \__pp_seglen:nn #1#2
  {
    \int_compare:nNnTF {#1} < {5}
      { \int_compare:nNnTF {#2} < {5} { \pp@nring } { \pp@nline } }
      { \int_compare:nNnTF {#2} < {5} { \pp@nline } { \pp@ninner } }
  }

% readable name of an end point: 3 or 3a
\cs_new:Npn \__pp_epname:n #1
  {
    \int_compare:nNnTF {#1} < {5}
      { \int_eval:n {#1} }
      { \int_eval:n { #1 - 5 } a }
  }

% ---------- the table of names (one per board type, built once)

\cs_new_protected:Npn \__pp_put:nnnn #1#2#3#4
  { \prop_gput:cee { g__pp_names_ \pp@stops _prop } {#1} { {#2} {#3} {#4} } }

% name #1 for the stop at distance #4 from end point #2 towards #3
\cs_new_protected:Npn \__pp_add_name:nnnn #1#2#3#4
  {
    \int_set:Nn \l_tmpa_int { \__pp_seglen:nn {#2} {#3} }
    \int_compare:nNnTF {#4} = {0}
      { \__pp_put:nnnn {#1} {#2} {-1} {0} }
      {
        \int_compare:nNnTF {#4} = { \l_tmpa_int + 1 }
          { \__pp_put:nnnn {#1} {#3} {-1} {0} }
          {
            \int_compare:nNnTF {#2} < {#3}
              { \__pp_put:nnnn {#1} {#2} {#3} {#4} }
              { \__pp_put:nnnn {#1} {#3} {#2} { \int_eval:n { \l_tmpa_int + 1 - #4 } } }
          }
      }
  }

% all names x/y/d along the line from end point #1 to end point #2
\cs_new_protected:Npn \__pp_add_line:nn #1#2
  {
    \int_step_inline:nnn { 0 } { \__pp_seglen:nn {#1} {#2} + 1 }
      {
        \__pp_add_name:nnnn
          { \__pp_epname:n {#1} / \__pp_epname:n {#2} / ##1 } {#1} {#2} {##1}
      }
  }

\cs_new_protected:Npn \__pp_add_both:nn #1#2
  { \__pp_add_line:nn {#1} {#2} \__pp_add_line:nn {#2} {#1} }

% names of version 1 for corner number #1 (0..5)
\cs_new_protected:Npn \__pp_add_old:n #1
  {
    \int_set:Nn \l_tmpb_int { \__pp_mod:n {#1} }
    \exp_args:NV \__pp_add_old_aux:nn \l_tmpb_int {#1}
  }
\cs_new_protected:Npn \__pp_add_old_aux:nn #1#2
  {
    \__pp_put:nnnn {#2} {#1} {-1} {0}
    \__pp_put:nnnn {#2a} { \int_eval:n {#1+5} } {-1} {0}
    \__pp_put:nnnn {c#2} {-2} {#1} {0}
    \int_step_inline:nn { \pp@nline }
      {
        \__pp_add_name:nnnn {#2+##1} {#1} { \int_eval:n { 5 + \__pp_mod:n {#1+2} } } {##1}
        \__pp_add_name:nnnn {#2-##1} {#1} { \int_eval:n { 5 + \__pp_mod:n {#1+3} } } {##1}
      }
    \int_step_inline:nn { \pp@nring }
      { \__pp_add_name:nnnn {#2r##1} {#1} { \__pp_mod:n {#1+1} } {##1} }
    \int_step_inline:nn { \pp@ninner }
      {
        \__pp_add_name:nnnn {#2a##1}
          { \int_eval:n {#1+5} } { \int_eval:n { 5 + \__pp_mod:n {#1+1} } } {##1}
      }
  }

\cs_new_protected:Npn \__pp_build_names:
  {
    \bool_if:cF { g__pp_built_ \pp@stops _bool }
      {
        \int_step_inline:nnn { 0 } { 4 }
          {
            \__pp_put:nnnn {##1} {##1} {-1} {0}
            \__pp_put:nnnn {##1a} { \int_eval:n {##1+5} } {-1} {0}
            \__pp_add_both:nn {##1} { \__pp_mod:n {##1+1} }
            \__pp_add_both:nn {##1} { \int_eval:n { 5 + \__pp_mod:n {##1+2} } }
            \__pp_add_both:nn {##1} { \int_eval:n { 5 + \__pp_mod:n {##1+3} } }
            \__pp_add_both:nn { \int_eval:n {##1+5} } { \int_eval:n { 5 + \__pp_mod:n {##1+1} } }
          }
        \int_step_inline:nnn { 0 } { 5 } { \__pp_add_old:n {##1} }
        \bool_gset_true:c { g__pp_built_ \pp@stops _bool }
      }
  }

% ---------- transforming a field

% field #3#4#5 under i -> #1*i + #2; result in \l__pp_fa/fb/fd_int
\cs_new_protected:Npn \__pp_tfield:nnnnn #1#2#3#4#5
  {
    \int_compare:nNnTF {#4} = {-1}
      {
        \int_set:Nn \l__pp_fa_int { \__pp_phi:nnn {#1} {#2} {#3} }
        \int_set:Nn \l__pp_fb_int {-1}
        \int_set:Nn \l__pp_fd_int {0}
      }
      {
        \int_compare:nNnTF {#3} = {-2}
          {
            \int_set:Nn \l__pp_fa_int {-2}
            \int_set:Nn \l__pp_fb_int { \__pp_mod:n { (#1) * (#4) + (#2) } }
            \int_set:Nn \l__pp_fd_int {0}
          }
          {
            \int_set:Nn \l__pp_fa_int { \__pp_phi:nnn {#1} {#2} {#3} }
            \int_set:Nn \l__pp_fb_int { \__pp_phi:nnn {#1} {#2} {#4} }
            \int_set:Nn \l__pp_fd_int {#5}
            \int_compare:nNnT { \l__pp_fa_int } > { \l__pp_fb_int }
              {
                \int_set:Nn \l_tmpa_int { \l__pp_fa_int }
                \int_set:Nn \l__pp_fa_int { \l__pp_fb_int }
                \int_set:Nn \l__pp_fb_int { \l_tmpa_int }
                \int_set:Nn \l__pp_fd_int
                  { \__pp_seglen:nn {#3} {#4} + 1 - #5 }
              }
          }
      }
  }

\cs_new:Npn \__pp_physname:
  {
    \int_compare:nNnTF { \l__pp_fb_int } = {-1}
      { pp- \int_use:N \l__pp_fa_int }
      {
        \int_compare:nNnTF { \l__pp_fa_int } = {-2}
          { pp-c- \int_use:N \l__pp_fb_int }
          { pp- \int_use:N \l__pp_fa_int - \int_use:N \l__pp_fb_int - \int_use:N \l__pp_fd_int }
      }
  }

\cs_new:Npn \__pp_readable:
  {
    \int_compare:nNnTF { \l__pp_fb_int } = {-1}
      { \__pp_epname:n { \l__pp_fa_int } }
      {
