% ---------- drawing with swap: arcs become inner lines and vice versa

\tl_new:N \pp@path
\int_new:N \l__pp_rr_int
\int_new:N \l__pp_rk_int
\clist_new:N \l__pp_sa_clist
\clist_new:N \l__pp_sb_clist

% append the name of ring position #2 (in stops) counted from corner #1
\cs_new_protected:Npn \__pp_put_ringname:nn #1#2
  {
    \int_set:Nn \l__pp_rr_int
      { \int_mod:nn { (#2) + 100 * ( \pp@nring + 1 ) } { \pp@nring + 1 } }
    \int_set:Nn \l__pp_rk_int
      { \__pp_mod:n { (#1) + ( (#2) - \l__pp_rr_int ) / ( \pp@nring + 1 ) } }
    \int_compare:nNnTF { \l__pp_rr_int } = {0}
      { \tl_put_right:Ne \pp@path { ( \int_use:N \l__pp_rk_int ) } }
      {
        \tl_put_right:Ne \pp@path
          {
            ( \int_use:N \l__pp_rk_int / \__pp_mod:n { \l__pp_rk_int + 1 }
              / \int_use:N \l__pp_rr_int )
          }
      }
  }

% path along the ring from position #2 to #3 of arc #1, through the
% names of the stops and corners, so it follows the map like any name
\cs_new_protected:Npn \pp_ringpath:nnn #1#2#3
  {
    \tl_clear:N \pp@path
    \__pp_put_ringname:nn {#1} {#2}
    \int_compare:nNnF {#2} = {#3}
      {
        \int_set:Nn \l_tmpa_int { \int_sign:n { (#3) - (#2) } }
        \int_step_inline:nnnn { (#2) + \l_tmpa_int } { \l_tmpa_int } { (#3) - \l_tmpa_int }
          {
            \int_compare:nNnT
              { \int_mod:nn { ##1 + 100 * ( \pp@nring + 1 ) } { \pp@nring + 1 } } = {0}
              { \tl_put_right:Nn \pp@path { -- } \__pp_put_ringname:nn {#1} {##1} }
          }
        \tl_put_right:Nn \pp@path { -- }
        \__pp_put_ringname:nn {#1} {#3}
      }
  }

% inner lines a field lies on (as "a-b"), for \plinie
\cs_new_protected:Npn \__pp_inner_segs:Nn #1#2
  {
    \clist_clear:N #1
    \prop_get:ceNT { g__pp_names_ \pp@stops _prop } {#2} \l_tmpa_tl
      { \exp_after:wN \__pp_inner_segs_aux:Nnnn \exp_after:wN #1 \l_tmpa_tl }
  }
\cs_new_protected:Npn \__pp_inner_segs_aux:Nnnn #1#2#3#4
  {
    \int_compare:nNnTF {#3} = {-1}
      {
        \int_compare:nNnT {#2} > {4}
          {
            \__pp_add_seg:Nnn #1 {#2} { 5 + \__pp_mod:n { #2 - 5 + 1 } }
            \__pp_add_seg:Nnn #1 {#2} { 5 + \__pp_mod:n { #2 - 5 + 4 } }
          }
      }
      {
        \bool_lazy_and:nnT { \int_compare_p:nNn {#2} > {4} } { \int_compare_p:nNn {#3} > {4} }
          { \__pp_add_seg:Nnn #1 {#2} {#3} }
      }
  }
\cs_new_protected:Npn \__pp_add_seg:Nnn #1#2#3
  {
    \clist_put_right:Ne #1
      { \int_eval:n { \int_min:nn {#2} {#3} } - \int_eval:n { \int_max:nn {#2} {#3} } }
  }

% true if #1 and #2 lie on a common inner line
\prg_new_protected_conditional:Npnn \pp_same_inner:nn #1#2 { T, F, TF }
  {
    \__pp_inner_segs:Nn \l__pp_sa_clist {#1}
    \__pp_inner_segs:Nn \l__pp_sb_clist {#2}
    \bool_set_false:N \l_tmpa_bool
    \clist_map_inline:Nn \l__pp_sa_clist
      { \clist_if_in:NnT \l__pp_sb_clist {##1} { \bool_set_true:N \l_tmpa_bool } }
    \bool_if:NTF \l_tmpa_bool { \prg_return_true: } { \prg_return_false: }
  }

