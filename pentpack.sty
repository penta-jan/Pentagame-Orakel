          \int_step_inline:nnn { 0 } { 1 }
            { \int_set:Nn \l__pp_s_int {##1} \__pp_try_mt: }
          \tl_gset_eq:NN \g__pp_string_tl \l__pp_best_tl
          \tl_gset:Ne \g__pp_code_tl
            { \str_range:enn { \str_mdfive_hash:V \l__pp_best_tl } {1} {8} }
        \group_end:
      }
