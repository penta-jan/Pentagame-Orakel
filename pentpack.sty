\def\pp@fieldscale{1}          % size factor for corners and junctions
\def\pp@lw{}                  % user line width; empty = scale with the board
\def\pp@arcoff{0}             % 0: arcs numbered from 0; 1: legacy numbering from 1
\def\pp@t{0}                 % turn: shift of all colour indices (0..4)
\def\pp@m{1}                 % mirror: 1 = no, -1 = mirror through the white corner
\def\pp@s{0}                 % swap: 1 = corner k <-> junction k
\def\pp@pieces{animals}      % animals, or shapes (triangle and square of version 1)
\def\pp@players{letters}     % letters, or animals for \addplayers
\def\pp@facing{inwards}      % animals face the vertical axis: left of it they face right,
                             % right of it left; outwards: the other way round;
                             % fixed: all face left, as drawn

\newcommand{\pp@setturn}[1]{%
  \edef\pp@t{\the\numexpr #1 - 5*((#1)/5) \relax}% remainder, may be negative
  \ifnum\pp@t<0 \edef\pp@t{\the\numexpr\pp@t+5\relax}\fi
  \ifnum\pp@t>4 \edef\pp@t{\the\numexpr\pp@t-5\relax}\fi
}
\newcommand{\pp@setswap}[1]{%
  \ifthenelse{\equal{#1}{false}}{\def\pp@s{0}}{\def\pp@s{1}}}
\newcommand{\pp@setmirror}[1]{%
  \ifthenelse{\equal{#1}{false}}{\def\pp@m{1}}{\def\pp@m{-1}}}

\newcommand{\pp@checkstops}[1]{%
  \ifthenelse{\equal{#1}{50}\OR\equal{#1}{100}}%
    {\def\pp@stops{#1}}%
    {\PackageError{pentpack}{Unknown board `stops=#1'}{Use stops=100 or stops=50.}}%
}

