% changes these defaults; the options and keys of the same names (and
% blackness, nogray) set them for both boards.
\@namedef{pp@bg@100}{black!40}  \@namedef{pp@st@100}{white}    \@namedef{pp@ac@100}{black!70}
\@namedef{pp@bg@50}{black!6}    \@namedef{pp@st@50}{black!22}  \@namedef{pp@ac@50}{black!55}
\@namedef{pp@ring@100}{double}  \@namedef{pp@ring@50}{single}  % track under the outer stops
