% parse colour #1: position index (or -1) and whether to draw it raw.
% Numbers are positions; letters, words and colour commands are looked
% up in the scheme of the current board.
\cs_new_protected:Npn \__pp_parse_colour:n #1
  {
    \tl_set:Nn \l__pp_craw_tl {#1}
    \tl_trim_spaces:N \l__pp_craw_tl
    \int_set:Nn \l__pp_cidx_int {-1}
    \bool_set_true:N \l__pp_rawok_bool
    \str_case:VnF \l__pp_craw_tl
      {
        {0} { \__pp_setc:nn {0} {F} }  {1} { \__pp_setc:nn {1} {F} }
        {2} { \__pp_setc:nn {2} {F} }  {3} { \__pp_setc:nn {3} {F} }
        {4} { \__pp_setc:nn {4} {F} }
        {W} { \__pp_findc:nn {white} {F} }  {G} { \__pp_findc:nn {green} {F} }
        {Y} { \__pp_findc:nn {yellow} {F} } {R} { \__pp_findc:nn {red} {F} }
        {B} { \__pp_findc:nn {blue} {F} }
        {white} { \__pp_findc:nn {white} {T} }  {green} { \__pp_findc:nn {green} {T} }
        {yellow} { \__pp_findc:nn {yellow} {T} } {red} { \__pp_findc:nn {red} {T} }
        {blue} { \__pp_findc:nn {blue} {T} }
        {\mywhite} { \__pp_findc:nn {white} {T} }  {\mygreen} { \__pp_findc:nn {green} {T} }
        {\myyellow} { \__pp_findc:nn {yellow} {T} } {\myred} { \__pp_findc:nn {red} {T} }
        {\myblue} { \__pp_findc:nn {blue} {T} }
      }
      { }
  }
\cs_new_protected:Npn \__pp_findc:nn #1#2
  {
    \int_step_inline:nnn { 0 } { 4 }
      {
        \str_if_eq:eeT { \__pp_word:nn { \pp@stops } {##1} } {#1}
          { \__pp_setc:nn {##1} {#2} }
      }
  }
\cs_new_protected:Npn \__pp_setc:nn #1#2
  {
    \int_set:Nn \l__pp_cidx_int {#1}
    \str_if_eq:nnTF {#2} {T}
      { \bool_set_true:N \l__pp_rawok_bool }
      { \bool_set_false:N \l__pp_rawok_bool }
  }

% colour to draw for input #2, stored in #1
\cs_new_protected:Npn \__pp_drawcolour:Nn #1#2
  {
    \__pp_parse_colour:n {#2}
    \int_compare:nNnTF { \l__pp_cidx_int } = {-1}
      { \tl_set_eq:NN #1 \l__pp_craw_tl }
      {
        \bool_lazy_and:nnTF
          { \l__pp_rawok_bool }
          { \int_compare_p:nNn { \pp@t } = {0} && \int_compare_p:nNn { \pp@m } = {1} }
          { \tl_set_eq:NN #1 \l__pp_craw_tl }
          {
            \tl_set:Ne #1
              {
                \__pp_cmacro:n
                  { \__pp_word:nn { \pp@stops }
                      { \__pp_mod:n { (\pp@m) * \l__pp_cidx_int + (\pp@t) } } }
              }
          }
      }
  }

