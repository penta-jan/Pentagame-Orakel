% letters in the position code
\def\pp@kind@hase{H}
\def\pp@kind@igel{I}
\def\pp@kind@gans{G}
\def\pp@kind@katze{K}

% style pp flip: xscale=-1 if the animal at node #1 has to face right.
% The drawn animals face left; the side of the board decides.
\newlength{\pp@px}
\newcommand{\pp@setflip}[1]{%
    \tikzset{pp flip/.style={}}%
    \ifthenelse{\equal{\pp@facing}{fixed}}{}{%
      \pgfextractx{\pp@px}{\pgfpointanchor{#1}{center}}%
      \ifthenelse{\equal{\pp@facing}{inwards}}%
        {\ifdim\pp@px<-1pt \tikzset{pp flip/.style={xscale=-1}}\fi}%
        {\ifdim\pp@px>1pt \tikzset{pp flip/.style={xscale=-1}}\fi}}}

% #1 animal, #2 colour (already mapped), #3 node, #4 size factor, #5 x shift
\newcommand{\pp@drawpiece}[5]{%
    \pp@setflip{#3}%
    \ifthenelse{\equal{\pp@pieces}{shapes}\AND\equal{#1}{hase}}%
      {\node[triangle,draw,fill=#2,xshift=#5] at (#3) {}}%
      {\ifthenelse{\equal{\pp@pieces}{shapes}\AND\equal{#1}{igel}}%
        {\node[square,draw,fill=#2,xshift=#5] at (#3) {}}%
        {\path ([xshift=#5]#3) pic[fill=#2,scale=#4*\pp@anisc,pp flip] {pp #1}}}}

\newcommand{\pp@piece}[3]{% #1 animal, #2 colour, #3 node
    \pp@record{\csname pp@kind@#1\endcsname}{#2}{#3}%
    \pp@setfill{#2}%
    \pp@drawpiece{#1}{\pp@fillcolour}{#3}{1}{0pt}}
\newcommand{\pp@oldpiece}[3]{\pp@piece{#1}{#3}{#2}}

\NewDocumentCommand{\phase}{om}{%
    \IfNoValueTF{#1}{\pp@oldpiece{hase}{#2}}{\pp@piece{hase}{#1}{#2}}}
\NewDocumentCommand{\pigel}{om}{%
    \IfNoValueTF{#1}{\pp@oldpiece{igel}{#2}}{\pp@piece{igel}{#1}{#2}}}
\NewDocumentCommand{\pgans}{om}{%
    \IfNoValueTF{#1}{\pp@oldpiece{gans}{#2}}{\pp@piece{gans}{#1}{#2}}}
\NewDocumentCommand{\pkatze}{om}{%
    \IfNoValueTF{#1}{\pp@oldpiece{katze}{#2}}{\pp@piece{katze}{#1}{#2}}}
\NewDocumentCommand{\ptri}{om}{%
    \IfNoValueTF{#1}{\pp@oldpiece{hase}{#2}}{\pp@piece{hase}{#1}{#2}}}
\NewDocumentCommand{\psqu}{om}{%
    \IfNoValueTF{#1}{\pp@oldpiece{igel}{#2}}{\pp@piece{igel}{#1}{#2}}}

% rabbit and hedgehog at one node: \ptwo[rabbit,hedgehog]{node} or
% \ptwo{node}{rabbit}{hedgehog}
\NewDocumentCommand{\ptwo}{om}{%
    \IfNoValueTF{#1}{\pp@oldtwo{#2}}{\pp@twosplit#1\@nil{#2}}}
\newcommand{\pp@oldtwo}[3]{\pp@two{#2}{#3}{#1}}
\def\pp@twosplit#1,#2\@nil#3{\pp@two{#1}{#2}{#3}}
\newcommand{\pp@two}[3]{%
    \pp@record{H}{#1}{#3}\pp@record{I}{#2}{#3}%
    \pp@settri{#1}\pp@setsqu{#2}%
    \ifthenelse{\equal{\pp@pieces}{shapes}}%
      {\def\pp@twoscale{1}\def\pp@twoshift{\svar}}%
      {\def\pp@twoscale{0.72}\def\pp@twoshift{0.85\svar}}%
    \pp@drawpiece{hase}{\pp@tricolour}{#3}{\pp@twoscale}{-\pp@twoshift};
    \pp@drawpiece{igel}{\pp@squcolour}{#3}{\pp@twoscale}{\pp@twoshift}}

%%%%%%%%%% HIGHLIGHTING AND PLAYERS

\newcommand{\phighlight}[1]{%
    \ifthenelse{\boolean{details}}%
      {\draw (#1) circle (3\svar);\def\pp@hl{3}}%
      {\def\pp@hl{1.5}}%
    \draw[line width=0.5\pfeildicke,->,>=\meinpfeil]
      ($(#1)!\pp@hl*\svar+5*\svar!(0,0)$) -- ($(#1)!\pp@hl*\svar!(0,0)$)}

\newcommand{\pp@letter}[1]{\ifcase#1\or A\or B\or C\or D\or E\fi}

\newcommand{\addplayers}[2][]{%
    \ifnum#2<2 \PackageError{pentpack}{\string\addplayers\space needs 2 to 5 players}{}\fi
    \ifnum#2>5 \PackageError{pentpack}{\string\addplayers\space needs 2 to 5 players}{}\fi
    \setlength{\nodr}{2\cvar}%
    \def\margin{12}% in degrees
    \foreach \xi in {1,...,#2} {
        \pgfmathsetmacro\pp@pa{360/#2*\xi+\rota-90}
        \ifthenelse{\equal{\pp@players}{animals}\AND\xi<5}%
          {\node (p\xi) at (\pp@pa:\kvar+1.3\nodr+\cvar) {\Large\phantom{$\mathcal{A}$}};
           \pp@setflip{p\xi}%
           \path (p\xi) pic[fill=white,scale=0.75*\nodr/28.45276,pp flip]
             {pp \ifcase\xi\or hase\or igel\or gans\or katze\fi};}%
          {\node (p\xi) at (\pp@pa:\kvar+1.3\nodr+\cvar) {\Large$\mathcal{\pp@letter{\xi}}$};}%
        \draw (p\xi) circle (\nodr);
        \draw[#1] ({\pp@pa-360/#2+\margin}:\kvar+1.3\nodr+\cvar)
           arc ({\pp@pa-360/#2+\margin}:{\pp@pa-\margin}:\kvar+1.3\nodr+\cvar);
    }
    \path}% the user's ";" closes this empty path

%%%%%%%%%% NODE NAMES (for reference and debugging)

\NewDocumentCommand{\pnodenames}{s O{}}{%
    \IfBooleanTF{#1}{\pp@newnames{#2}}{\pp@oldnames{#2}}}

\newcommand{\pp@oldnames}[1]{%
    \pgfmathsetmacro\pp@lsc{\svar/5.2}%
    \foreach \s in {0,...,4} {
        \foreach \q in {1,...,\pp@nline} {
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\s+\q) {\s+\q};
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\s-\q) {\s-\q};
        }
        \foreach \q in {1,...,\pp@ninner} {
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\s a\q) {\s a\q};
        }
        \foreach \t in {1,...,\pp@nring} {
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\s r\t) {\s r\t};
        }
        \node[font=\tiny\ttfamily,scale=1.4*\pp@lsc,#1] at (\s) {\s};
        \node[font=\tiny\ttfamily,scale=1.4*\pp@lsc,#1] at (\s a) {\s a};
    }
    \path}

% one name per stop: long lines from the corner, arcs and inner lines
% counter-clockwise
\newcommand{\pp@newnames}[1]{%
    \pgfmathsetmacro\pp@lsc{\svar/8.5}%
    \foreach \s in {0,...,4} {
        \foreach \q in {1,...,\pp@nline} {
            \edef\pp@n{\pp@stopname{\s}{\the\numexpr\pp@mod{\s+2}+5\relax}{\q}}%
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\pp@n) {\pp@n};
            \edef\pp@n{\pp@stopname{\s}{\the\numexpr\pp@mod{\s+3}+5\relax}{\q}}%
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\pp@n) {\pp@n};
        }
        \foreach \q in {1,...,\pp@ninner} {
            \edef\pp@n{\pp@stopname{\the\numexpr\s+5\relax}{\the\numexpr\pp@mod{\s+1}+5\relax}{\q}}%
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\pp@n) {\pp@n};
        }
        \foreach \t in {1,...,\pp@nring} {
            \edef\pp@n{\pp@stopname{\s}{\pp@mod{\s+1}}{\t}}%
            \node[font=\tiny\ttfamily,scale=\pp@lsc,#1] at (\pp@n) {\pp@n};
        }
        \node[font=\tiny\ttfamily,scale=2*\pp@lsc,#1] at (\s) {\s};
        \node[font=\tiny\ttfamily,scale=2*\pp@lsc,#1] at (\s a) {\s a};
    }
    \path}

%%%%%%%%%% META DATA

\newcommand{\pdatum}{unknown date}
\newcommand{\pspieler}{unknown players}
\newcommand{\port}{unknown location}
\newcommand{\ptomove}{unknown who to move}

\newcommand{\pdata}[4]{%
    \renewcommand{\pspieler}{#1}%
    \renewcommand{\pdatum}{#2}%
    \renewcommand{\port}{#3}%
    \renewcommand{\ptomove}{#4}%
}

% \pshowdata and \pshowcode go below the board; whichever comes second
% is placed below the first.
\newcommand{\pp@below}{(0,-\kvar-\cvar)}
\newcommand{\pp@ifshown}[1]{\pgfutil@ifundefined{pgf@sh@ns@#1}{\@secondoftwo}{\@firstoftwo}}
\newcommand{\pp@forget}[1]{\expandafter\let\csname pgf@sh@ns@#1\endcsname\relax}

\newcommand{\pshowdata}{%
    \pp@ifshown{pp-code}%
      {\def\pp@y{pp-code.south}}{\def\pp@y{0,-\kvar-\cvar}}%
    \node[name=pp-data,anchor=north,text width=2\kvar,align=center]
      at (0,0 |- \pp@y) {%
        \pspieler;\\ \pdatum, \port\\ \ptomove\ to move}}

\newcommand{\pshowcode}[1][]{%
    \pp@computecode
    \pp@ifshown{pp-data}%
      {\def\pp@y{pp-data.south}}{\def\pp@y{0,-\kvar-\cvar}}%
    \node[name=pp-code,anchor=north east,inner sep=1pt,font=\scriptsize\ttfamily,#1]
      at (\kvar+\cvar,0 |- \pp@y) {\ppositioncode}}

%%%%%%%%%% THE BOARD

\tikzset{
    corn/.pic={
        \filldraw[draw=\stopaccent, fill, line width=0.3pt] (0,0) circle (\cvar);
        % only the detailed board (with all stops) shows the corner as a ring, as on the real board;
        % the simplified diagrams draw it solid, like the junctions
        \ifthenelse{\boolean{details}}
          {\filldraw[draw=\stopaccent, fill=\stopshade, line width=0.3pt] (0,0) circle (0.8\cvar);}{}
    },
    junc/.pic={
        \filldraw[draw=\stopaccent, fill, line width=0.3pt] (0,0) circle (\jvar);
    },
}

\tikzset{
    mypboard/.pic={
        \ifthenelse{\boolean{details}}{
            \fill[color=\blackness] (0,0) circle (\kvar+\cvar);
            \ifthenelse{\boolean{noring}}{}{\draw (0,0) circle (\kvar+\cvar);}
            \ifx\pp@ring\@empty\edef\pp@rg{\csname pp@ring@\pp@stops\endcsname}\else\let\pp@rg\pp@ring\fi
            \ifthenelse{\equal{\pp@rg}{single}}
              {\draw[line width=0.3pt,color=black] (0,0) circle (\kvar);}
              {\draw[line width=\ringwidth,color=gray!15] (0,0) circle (\kvar);
               \draw[line width=0.3pt,color=black] (0,0) circle (\kvar+0.5\ringwidth);
               \draw[line width=0.3pt,color=black] (0,0) circle (\kvar-0.5\ringwidth);}
        }{
            \ifthenelse{\boolean{solid}}
                {\draw (0,0) circle (\kvar);}
                {\draw[dashed] (0,0) circle (\kvar);}
            \ifthenelse{\boolean{solid}}{\def\pp@ls{solid}}{\def\pp@ls{dotted}}
            \draw[\pp@ls] (pp-0) -- (pp-2) -- (pp-4) -- (pp-1) -- (pp-3) -- cycle;
        }
        \foreach \s in {0,...,4} {
            \edef\pp@cc{\mycolor{\s}}%
            \draw (pp-\s) pic[color=\pp@cc] {corn};
            \edef\pp@cc{\myjcolor{\s}}%
            \draw (pp-\the\numexpr\s+5\relax) pic[color=\pp@cc] {junc};
        }
        \ifthenelse{\boolean{details}}{\pp@drawstops}{}
    }
}

\NewEnviron{pentdiag}[1][]{%
    \pp@diagopts{#1}%
    \pp@geometry
    \pp@resetrecords
    \pp@forget{pp-data}\pp@forget{pp-code}%
    \begin{tikzpicture}[draw=\linecolor]%
        \pp@makepoints
        \pic{mypboard};%
        \pp@makenames
        \BODY
    \end{tikzpicture}%
    \pp@computecode
    \pp@logcode
}

