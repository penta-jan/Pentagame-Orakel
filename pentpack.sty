% #1 kind (T, S or block), #2 colour input, #3 node name
\cs_new_protected:Npn \pp_record:nnn #1#2#3
  {
    \__pp_build_names:
    \__pp_parse_colour:n {#2}
    \str_if_eq:nnTF {#1} {block}
      {
        \str_case:VnF \l__pp_craw_tl
          { {} { \tl_set:Nn \l__pp_col_tl { x {} } } {black} { \tl_set:Nn \l__pp_col_tl { x {} } }
            {gray} { \tl_set:Nn \l__pp_col_tl { g {} } } {grey} { \tl_set:Nn \l__pp_col_tl { g {} } } }
          {
            \int_compare:nNnTF { \l__pp_cidx_int } = {-1}
              { \tl_set:Ne \l__pp_col_tl { b { r \exp_not:V \l__pp_craw_tl } } }
              { \tl_set:Ne \l__pp_col_tl { b { i \int_use:N \l__pp_cidx_int } } }
          }
      }
      {
        \int_compare:nNnTF { \l__pp_cidx_int } = {-1}
          { \tl_set:Ne \l__pp_col_tl { #1 { r \exp_not:V \l__pp_craw_tl } } }
          { \tl_set:Ne \l__pp_col_tl { #1 { i \int_use:N \l__pp_cidx_int } } }
      }
    \prop_get:ceNTF { g__pp_names_ \pp@stops _prop } {#3} \l_tmpa_tl
      { \seq_gput_right:Ne \g__pp_records_seq { { \exp_not:V \l__pp_col_tl } \exp_not:V \l_tmpa_tl } }
      { }
  }

