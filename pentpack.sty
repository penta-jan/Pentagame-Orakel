% helpers that create the drawn points
\newcommand{\pp@mkcorner}[1]{\coordinate (pp-#1) at ({\rota+72*#1}:\kvar);}
\newcommand{\pp@mkjunction}[2]{\coordinate (pp-#1) at ({\rota+72*#2}:{-0.381966*\kvar});}
\newcommand{\pp@mkcentre}[1]{\coordinate (pp-c-#1) at ({\rota+72*#1}:\cvar);}
\newcommand{\pp@mkring}[3]{\coordinate (#1) at ({\rota+72*#2+(#3)*\pp@step}:\kvar);}
\newcommand{\pp@mkline}[5]{\coordinate (#1) at ($(#2)!{#4+(2*#5-1)*\svar}!(#3)$);}
\newcommand{\pp@drawstop}[1]{\filldraw[small] (#1) circle (\svar);}

%%%%%%%%%% LINES AND ARCS
% None of the drawing commands ends in ";" -- close them yourself.

% With swap, a line along an inner line of the logical diagram lies on
% the ring and is drawn as an arc.
\newcommand{\plinie}[3]{%
    \ifnum\pp@s=1
      \pp@ifsameinnerTF{#1}{#2}{\pp@ringlinie{#1}{#2}{#3}}{\pp@straightlinie{#1}{#2}{#3}}%
    \else
      \pp@straightlinie{#1}{#2}{#3}%
    \fi}
\newcommand{\pp@straightlinie}[3]{%
    \draw[#3,line width=\pfeildicke,>=\meinpfeil,cap=round] (#1.center) -- (#2.center)}
\newcommand{\pp@ringlinie}[3]{%
    \draw[#3,line width=\pfeildicke,>=\meinpfeil,cap=round]
      let \p1=(#1), \p2=(#2), \n1={atan2(\y1,\x1)}, \n2={atan2(\y2,\x2)},
          \n3={mod(\n2-\n1+540,360)-180}
      in (#1) arc[start angle=\n1, delta angle=\n3, radius=\kvar]}

% With swap, arcs lie on the inner pentagon and are drawn as straight lines.
\newcommand{\pp@swaparc}[4]{% arc, from, to, options
    \pp@ringpath{#1}{#2}{#3}%
    \expandafter\pp@drawpath\expandafter{\pp@path}{#4}}
\def\pp@drawpath#1#2{%
    \draw[#2,>=\meinpfeil,line width=\pfeildicke,cap=round,join=round] #1}

% angle of corner #1 after turning and mirroring
\newcommand{\pp@cangle}[1]{(\rota+72*(\pp@t+(\pp@m)*((#1)-\pp@arcoff)))}

% arc #1 runs counter-clockwise from corner #1 to corner #1+1
\newcommand{\pbogen}[2]{%
    \ifnum\pp@s=1 \pp@swaparc{#1}{0}{\pp@nring+1}{#2}\else\pp@pbogen{#1}{#2}\fi}
\newcommand{\pp@pbogen}[2]{%
    \draw[#2,>=\meinpfeil,line width=\pfeildicke,cap=round]
      ({\pp@cangle{#1}}:\kvar) arc ({\pp@cangle{#1}}:{\pp@cangle{#1}+(\pp@m)*72}:\kvar)}

\newcommand{\pbogenx}[2]{%
    \ifnum\pp@s=1 \pp@swaparc{#1}{0}{\pp@nring+1}{#2}\else\pp@pbogenx{#1}{#2}\fi}
\newcommand{\pp@pbogenx}[2]{%
    \draw[#2,>=\meinpfeil,line width=\pfeildicke,cap=round]
      ({\pp@cangle{#1}}:\kvar+\pfeildicke) arc
      ({\pp@cangle{#1}}:{\pp@cangle{#1}+(\pp@m)*72}:\kvar+\pfeildicke)}

% part of arc #1 from stop #2 to stop #3; stop 0 is corner #1, and the
% next corner is stop 4 (100 stops) or stop 2 (50 stops).
% If #3 < #2 the arc runs clockwise.
\newcommand{\pkbogen}[4]{%
    \ifnum\pp@s=1 \pp@swaparc{#1}{#2}{#3}{#4}\else\pp@pkbogen{#1}{#2}{#3}{#4}\fi}
\newcommand{\pp@pkbogen}[4]{%
    \draw[#4,>=\meinpfeil,line width=\pfeildicke,cap=round]
      ({\pp@cangle{#1}+(\pp@m)*(#2)*\pp@step}:\kvar) arc
      ({\pp@cangle{#1}+(\pp@m)*(#2)*\pp@step}:{\pp@cangle{#1}+(\pp@m)*(#3)*\pp@step}:\kvar)}

%%%%%%%%%% BLOCKS

\tikzset{
    small/.style={line width=0.3pt,draw=\stopaccent,fill=\stopshade},
}

% #1 style, #2 colour, #3 node
\newcommand{\pp@block}[3]{%
    \pp@record{block}{#2}{#3}%
    \pp@setfill{#2}%
    \ifx\pp@fillcolour\@empty\def\pp@fillcolour{black}\fi
    \filldraw[#1,fill=\pp@fillcolour] (#3) circle (\fvar)}

\newcommand{\pblock}[2][]{\pp@block{draw=black}{#1}{#2}}

% block arc #1 (from corner #1 to corner #1+1) in the middle
\newcommand{\pcbog}[1]{%
    \edef\pp@tmp{\pp@stopname{\pp@mod{#1}}{\pp@mod{#1+1}}{\pp@midring}}%
    \pp@block{draw=black}{}{\pp@tmp}}

% block the long line from corner #1 clockwise (l) or counter-clockwise (r)
\newcommand{\pccornl}[1]{%
    \edef\pp@tmp{\pp@stopname{\pp@mod{#1}}{\the\numexpr\pp@mod{#1+2}+5\relax}{\pp@ccorn}}%
    \pp@block{small}{}{\pp@tmp}}

\newcommand{\pccornr}[1]{%
    \edef\pp@tmp{\pp@stopname{\pp@mod{#1}}{\the\numexpr\pp@mod{#1+3}+5\relax}{\pp@ccorn}}%
    \pp@block{small}{}{\pp@tmp}}

% block the short line opposite corner #1, in the middle
\newcommand{\pcjunct}[1]{%
    \edef\pp@tmp{\pp@stopname{\the\numexpr\pp@mod{#1+2}+5\relax}{\the\numexpr\pp@mod{#1+3}+5\relax}{\pp@midinner}}%
    \pp@block{draw=black}{}{\pp@tmp}}

\tikzset{
    ccorn/.pic={
        \filldraw[small,fill=black] (-162+\rota:\cvar+\pp@ccorn*2*\svar-\svar) circle (\fvar);
    },
    cjunc/.pic={
        \filldraw[small,fill=black] (\rota:0.309017*\kvar) circle (\fvar);
    },
}

