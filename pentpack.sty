\cs_new_protected:Npn \__pp_try:nn #1#2
  {
    \__pp_items_for:nn {#1} {#2}
    \bool_if:NTF \l__pp_first_bool
      { \tl_set_eq:NN \l__pp_best_tl \l__pp_cur_tl \bool_set_false:N \l__pp_first_bool }
      {
        \str_compare:eNeTF { \l__pp_cur_tl } < { \l__pp_best_tl }
          { \tl_set_eq:NN \l__pp_best_tl \l__pp_cur_tl } { }
      }
  }
\cs_new_protected:Npn \__pp_try_mt:
  {
    \clist_map_inline:nn { 1, -1 }
      { \int_step_inline:nnn { 0 } { 4 } { \__pp_try:nn {##1} {####1} } }
