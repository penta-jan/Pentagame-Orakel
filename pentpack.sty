\define@key{pentpack@diag}{stops}{\pp@checkstops{#1}}
\define@key{pentpack@diag}{radius}{\def\pp@radius{#1}}
\define@key{pentpack@diag}{fieldscale}{\def\pp@fieldscale{#1}}
\define@key{pentpack@diag}{rotate}{\renewcommand{\rota}{#1}}
\define@key{pentpack@diag}{turn}{\pp@setturn{#1}}
\define@key{pentpack@diag}{background}{\renewcommand{\blackness}{#1}}
\define@key{pentpack@diag}{stopcolour}{\renewcommand{\stopshade}{#1}}
\define@key{pentpack@diag}{stopline}{\renewcommand{\stopaccent}{#1}}
\define@key{pentpack@diag}{ring}{\def\pp@ring{#1}}
\define@key{pentpack@diag}{blackness}{\renewcommand{\blackness}{black!#1}}

% defaults of one board type: \pentboardstyle[50]{background=..., ...}
\define@key{pentpack@style}{background}{\expandafter\def\csname pp@bg@\pp@which\endcsname{#1}}
\define@key{pentpack@style}{stopcolour}{\expandafter\def\csname pp@st@\pp@which\endcsname{#1}}
\define@key{pentpack@style}{stopline}{\expandafter\def\csname pp@ac@\pp@which\endcsname{#1}}
\define@key{pentpack@style}{ring}{\expandafter\def\csname pp@ring@\pp@which\endcsname{#1}}
\newcommand{\pentboardstyle}[2][]{%
  \ifx\relax#1\relax
    \def\pp@which{50}\setkeys{pentpack@style}{#2}%
    \def\pp@which{100}\setkeys{pentpack@style}{#2}%
  \else
    \def\pp@which{#1}\setkeys{pentpack@style}{#2}%
  \fi}
\define@key{pentpack@diag}{pieces}{\def\pp@pieces{#1}}
\define@key{pentpack@diag}{facing}{\def\pp@facing{#1}}
\define@key{pentpack@diag}{players}{\def\pp@players{#1}}
\define@key{pentpack@diag}{mirror}[true]{\pp@setmirror{#1}}
\define@key{pentpack@diag}{swap}[true]{\pp@setswap{#1}}
\define@key{pentpack@diag}{simple}[true]{%
  \ifthenelse{\equal{#1}{false}}%
    {\setboolean{details}{true}}{\setboolean{details}{false}}}

\newcommand{\pentsetup}[1]{\setkeys{pentpack@diag}{#1}}

% The optional argument of pentdiag is either a bare radius (as in v1)
% or a key list (stops=50, radius=4cm, rotate=0, turn=2, mirror, swap, simple).
\newcommand{\pp@diagopts}[1]{%
  \in@{=}{#1}%
  \ifin@
    \setkeys{pentpack@diag}{#1}%
  \else
    \in@{simple}{#1}%
    \ifin@
      \setkeys{pentpack@diag}{#1}%
    \else
      \in@{mirror}{#1}%
      \ifin@
        \setkeys{pentpack@diag}{#1}%
      \else
        \in@{swap}{#1}%
        \ifin@
          \setkeys{pentpack@diag}{#1}%
        \else
          \ifx\relax#1\relax\else\def\pp@radius{#1}\fi
        \fi
      \fi
    \fi
  \fi
}

% Geometry. Along straight lines the stops touch each other and the
% corners/junctions; all sizes are multiples of the stop radius \svar.
%   100 stops: 6 stops corner-junction, 3 junction-junction, 3 on each arc
%              corner = sqrt5 * stop, junction = 2.02606 * stop
%   50 stops:  3 stops corner-junction, 1 junction-junction, 1 on each arc
%              corner = junction = sqrt5 * stop
\newcommand{\pp@geometry}{%
  \setlength{\kvar}{\pp@radius}%
  \ifnum\pp@stops=50\relax
    \setlength{\svar}{0.0693786\kvar}% ring radius = 14.41366 stops
    \setlength{\cvar}{2.23607\svar}%
    \setlength{\jvar}{2.23607\svar}%
    \def\pp@nline{3}\def\pp@ninner{1}\def\pp@nring{1}%
    \def\pp@step{36}\def\pp@ccorn{2}\def\pp@midring{1}\def\pp@midinner{1}%
    \def\pp@autolw{0.0357441\kvar}% same width as on the 100-stop board
  \else
    \setlength{\svar}{0.0446801\kvar}% ring radius = 22.38133 stops
    \setlength{\cvar}{2.23606\svar}%
    \setlength{\jvar}{2.02606\svar}%
    \def\pp@nline{6}\def\pp@ninner{3}\def\pp@nring{3}%
    \def\pp@step{18}\def\pp@ccorn{3}\def\pp@midring{2}\def\pp@midinner{2}%
    \def\pp@autolw{0.8\svar}%
  \fi
  \setlength{\cvar}{\pp@fieldscale\cvar}% fieldscale: corners and junctions smaller or larger (simplified diagrams)
  \setlength{\jvar}{\pp@fieldscale\jvar}%
  \setlength{\fvar}{0.75\svar}%
  \setlength{\pp@anilw}{0.12\svar}%
  \pgfmathsetmacro\pp@anisc{1.25*\svar/28.45276}% animal radius 1.25 stops
  \setlength{\ringwidth}{0.4\svar}%
  \ifx\pp@lw\@empty
    \setlength{\pfeildicke}{\pp@autolw}%
  \else
    \setlength{\pfeildicke}{\pp@lw}%
  \fi
}

